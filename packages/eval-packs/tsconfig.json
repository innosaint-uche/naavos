{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "allowJs": false,
    "checkJs": false,
    "tsBuildInfoFile": "../../dist/packages/eval-packs/tsconfig.tsbuildinfo"
