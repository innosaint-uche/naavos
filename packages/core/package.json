{
  "name": "@naavos/core",
  "version": "1.0.0",
  "description": "NAAvOS core utilities — avatar schema definition and validation",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "naavos-validate": "dist/validate.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "validate": "node dist/validate.js"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "keywords": [
    "naavos",
    "avatar",
    "cognitive-profile"
  ],
  "license": "MIT",
  "prepare": "tsc -p tsconfig.json"
}
