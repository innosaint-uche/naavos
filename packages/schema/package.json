{
  "name": "@naavos/schema",
  "version": "1.0.0",
  "description": "NAAvOS avatar package schema and validation",
  "main": "src/index.js",
  "module": "src/index.js",
  "exports": {
    ".": {
      "import": "./src/index.js",
      "default": "./src/index.js"
    }
  },
  "type": "module",
  "scripts": {
    "build": "node ../../scripts/build-schema.mjs",
    "lint": "eslint src --ext .js",
